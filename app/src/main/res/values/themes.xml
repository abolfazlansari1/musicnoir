<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="noir_bg">#FF0B0A12</color>
    <style name="Theme.NoirMusic" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/noir_bg</item>
        <item name="android:colorBackground">@color/noir_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.NoirMusic.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/noir_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_noir_foreground</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.NoirMusic</item>
    </style>
</resources>
